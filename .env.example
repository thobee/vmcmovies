# VMC — copy to .env.local

# Telegram bot username (without @) for download deep links
NEXT_PUBLIC_TELEGRAM_BOT=VmcfileBot
NEXT_PUBLIC_TELEGRAM_CHANNEL=https://t.me/+mwgLjKLBwYZkZmY0
NEXT_PUBLIC_WHATSAPP_GROUP=https://chat.whatsapp.com/F1gdeQA8GHRK5HyZRCNaUz

# MongoDB — local (npm run mongo:local) or Atlas
MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=vmcmovies
MONGODB_DB_NAME=vmc

# Session signing — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Bachs — https://app.bachs.io → Developer Portal → API Keys
# Sandbox: sk_sandbox_...  Production: sk_live_...
BACHS_API_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret from Developer Portal → Webhooks → your endpoint
BACHS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public app URL (use your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bachs rejects localhost for success/cancel URLs — set to your live domain when deployed:
# BACHS_RETURN_BASE_URL=https://www.yoursite.com

# Google sign-in — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin panel — generate hash: npm run admin:hash-password -- yourpassword
# On Windows, wrap the hash in quotes (see script output).
ADMIN_EMAIL=admin@vmc.com
ADMIN_PASSWORD_HASH=""

# Optional: hide /admin/login from scanners. After this is set, open
#   /admin/login?g=YOUR_VALUE
# once — a 30-day cookie is stored. Bookmark the clean /admin/login URL after that.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_GATE=

# TMDB — free key from https://www.themoviedb.org/settings/api (v3 auth)
TMDB_API_KEY=

# Cloudinary — admin image uploads (required in production on Vercel)
# Dashboard: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# optional folder prefix (default: vmc)
CLOUDINARY_FOLDER=vmc

# Resend — payment receipt emails (https://resend.com/api-keys)
RESEND_API_KEY=
# From address — onboarding@resend.dev only delivers to YOUR Resend signup email (not subscribers).
# Verify a domain at resend.com/domains, then use: VMC <noreply@yourdomain.com>
EMAIL_FROM=
# Your inbox for "new payment" alerts (falls back to ADMIN_EMAIL if empty)
ADMIN_NOTIFY_EMAIL=
